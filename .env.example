# ===== Supabase (wajib untuk login & manajemen akun) =====
# Dashboard -> Project Settings -> API
# URL tanpa akhiran /rest/v1
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# service_role / secret key. HANYA untuk server, jangan pernah dipakai di browser.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ===== Auth.js =====
# Buat dengan: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
NEXTAUTH_URL="http://localhost:3000"

# ===== Database Supabase (Prisma, opsional untuk tahap berikutnya) =====
# Port 6543 = transaction pooler (dipakai aplikasi/serverless)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Port 5432 = session pooler (dipakai prisma migrate)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# ===== Vercel Cron =====
CRON_SECRET="ganti-dengan-secret-acak"
